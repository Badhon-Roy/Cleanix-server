            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && (jsonData.data.accessToken || jsonData.accessToken)) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken || jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
