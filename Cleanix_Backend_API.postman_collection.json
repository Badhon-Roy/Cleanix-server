            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"badhon.cleanix@gmail.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/send-register-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "send-register-otp"]
            },
            "description": "Sends a 6-digit OTP verification code to the provided email address before registration."
          },
          "response": []
        },
        {
          "name": "Step 2: Verify Registration OTP",
          "request": {
            "method": "POST",
            "header": [
              {
