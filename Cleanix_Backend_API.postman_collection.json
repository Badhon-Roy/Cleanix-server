        {
          "name": "Step 1: Input Account Info & Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer.cleanix@gmail.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/send-register-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "send-register-otp"]
            },
            "description": "1st API Request in Customer Flow: User enters account info on UI and clicks 'Next', triggering 6-digit OTP dispatch to email."
          },
          "response": []
        },
        {
          "name": "Step 2: Input 6-Digit OTP & Verify Email",
          "request": {
            "method": "POST",
            "header": [
