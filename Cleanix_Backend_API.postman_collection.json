              "raw": "{\n  \"name\": \"Badhon Roy\",\n  \"email\": \"badhon.cleanix@gmail.com\",\n  \"phone\": \"+8801700000000\",\n  \"password\": \"Cleanix@2026\",\n  \"role\": \"CUSTOMER\"\n}",
