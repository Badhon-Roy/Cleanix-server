              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-register-otp"]
            },
            "description": "Verifies the 6-digit OTP code sent to the email address."
          },
          "response": []
        },
        {
          "name": "Step 3a: Register Customer Account (JSON)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && (jsonData.data.accessToken || jsonData.accessToken)) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken || jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
