                  "value": "+8801700000000",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "Cleanix@2026",
                  "type": "text"
                },
                {
                  "key": "role",
                  "value": "CUSTOMER",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "3rd API Request in Customer Flow: Once email is verified, posts complete form data to create account in Database."
          },
          "response": []
